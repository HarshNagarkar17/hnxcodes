---
interface Props {
  id?: string;
  title?: string;
  titleSize?: 'default' | 'small';
  class?: string;
}

const { id, title, titleSize = 'default', class: className } = Astro.props;
---

<section id={id} class:list={['section', className]}>
  {title && (
    <div class:list={['section-header', { 'section-header--small': titleSize === 'small' }]}>
      <h2 class="section-title">{title}</h2>
      <span class="section-line" aria-hidden="true"></span>
    </div>
  )}
  <slot />
</section>

<style>
  .section {
    margin-bottom: var(--space-16);
  }

  .section:last-child {
    margin-bottom: 0;
  }

  .section-header {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-bottom: var(--space-8);
  }

  .section-header--small {
    margin-bottom: var(--space-5);
  }

  .section-title {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 400;
    letter-spacing: -0.02em;
    margin: 0;
    color: var(--color-fg);
    white-space: nowrap;
  }

  .section-header--small .section-title {
    font-size: var(--text-lg);
  }

  .section-line {
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, var(--color-border), transparent);
    min-width: 40px;
  }
</style>
