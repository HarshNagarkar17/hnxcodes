---
import Layout from "../../layouts/Layout.astro";
import { projects, site } from "../../data/portfolio";
---

<Layout
  title={`Projects | ${site.name}`}
  description="Projects and side work by Harsh Nagarkar — web apps, tools, and experiments in TypeScript, React, Next.js, and more."
>
  <article class="page">
    <header class="page-header">
      <h1 class="page-title reveal reveal-delay-1">Projects</h1>
      <p class="page-desc reveal reveal-delay-2">Things I've built</p>
    </header>

    <div class="projects-grid">
      {
        projects.map((project) => {
          const isExternal = project.href.startsWith("http");

          return (
            <li class="project-item">
              <a
                href={project.href}
                target={isExternal ? "_blank" : undefined}
                rel={isExternal ? "noopener noreferrer" : undefined}
                class="project-link"
              >
                {project.title}
              </a>
              {project.description && (
                <span class="project-desc"> — {project.description}</span>
              )}
            </li>
          );
        })
      }
    </div>
  </article>
</Layout>

<style>
  .page {
    padding-top: var(--space-16);
  }

  .page-header {
    margin-bottom: var(--space-12);
    max-width: 36rem;
  }

  .page-label {
    font-size: var(--text-sm);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-accent);
    margin: 0 0 var(--space-4);
  }

  .page-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, var(--text-4xl));
    font-weight: 400;
    letter-spacing: -0.03em;
    margin: 0 0 var(--space-3);
    color: var(--color-fg);
  }

  .page-desc {
    font-size: var(--text-lg);
    color: var(--color-muted);
    margin: 0;
    line-height: 1.6;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--space-5);
  }

  .project-card {
    display: flex;
    flex-direction: column;
    padding: var(--space-6);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    text-decoration: none;
    position: relative;
    overflow: hidden;
  }

  .project-card:hover {
    text-decoration: none;
    color: inherit;
  }

  .project-card-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: var(--space-3);
  }

  .project-name {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 500;
    margin: 0;
    color: var(--color-fg);
  }

  .project-arrow {
    font-size: var(--text-lg);
    color: var(--color-muted);
    transition: all var(--transition);
    opacity: 0;
    transform: translate(-4px, 4px);
  }

  .project-card:hover .project-arrow {
    opacity: 1;
    transform: translate(0, 0);
    color: var(--color-accent);
  }

  .project-desc {
    margin: 0 0 auto;
    padding-bottom: var(--space-4);
    color: var(--color-fg-secondary);
    line-height: 1.65;
    font-size: var(--text-sm);
    flex: 1;
  }

  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .project-tag {
    font-size: var(--text-xs);
    font-weight: 500;
    padding: var(--space-1) var(--space-3);
    background: var(--color-accent-soft);
    color: var(--color-accent);
    border-radius: 100px;
  }

  .project-badge {
    position: absolute;
    top: var(--space-4);
    right: var(--space-4);
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-accent);
    background: var(--color-accent-soft);
    padding: var(--space-1) var(--space-3);
    border-radius: 100px;
  }

  @media (max-width: 640px) {
    .projects-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
