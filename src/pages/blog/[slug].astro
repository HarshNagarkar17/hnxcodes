---
import Layout from "../../layouts/Layout.astro";
import BlogBody from "../../components/BlogBody.tsx";
import { sanityClient } from "sanity:client";
import { site } from "../../data/portfolio";
import {
  POST_BY_SLUG_QUERY,
  POST_SLUGS_QUERY,
  formatPostDate,
  type PostDetail,
} from "../../lib/sanity-posts";
import { urlForImage } from "../../lib/sanity-image";

export async function getStaticPaths() {
  const rows = await sanityClient.fetch<{ slug: string }[]>(POST_SLUGS_QUERY);
  return rows.map((row) => ({
    params: { slug: row.slug },
  }));
}

const { slug } = Astro.params;
const post = await sanityClient.fetch<PostDetail | null>(POST_BY_SLUG_QUERY, {
  slug,
});

if (!post) {
  return new Response(null, { status: 404 });
}

const metaDescription = post.excerpt?.trim() || `${post.title} — blog post`;

const publishedAt = formatPostDate(post.publishedAt);

let ogImage: string | undefined;
let heroImageSrc: string | undefined;
let heroImageAlt = "";
if (post.mainImage?.asset) {
  try {
    ogImage = urlForImage(post.mainImage)
      .width(1200)
      .height(630)
      .fit("crop")
      .url();
    heroImageSrc = urlForImage(post.mainImage).width(1200).fit("max").url();
    heroImageAlt = post.mainImage.alt?.trim() || post.title;
  } catch {
    ogImage = undefined;
    heroImageSrc = undefined;
  }
}

function formatDate(d: Date) {
  return d.toLocaleDateString("en-GB", {
    year: "numeric",
    month: "short",
    day: "numeric",
  });
}
---

<Layout
  title={`${post.title} | ${site.name}`}
  description={metaDescription}
  canonicalPath={`/blog/${post.slug}`}
  ogImage={ogImage}
>
  <article class="post">
    <header class="post-header">
      <a href="/blog" class="post-back">← Blog</a>
      {
        publishedAt ? (
          <time class="post-date" datetime={publishedAt.toISOString()}>
            {formatDate(publishedAt)}
          </time>
        ) : null
      }
      {
        heroImageSrc ? (
          <figure class="post-hero">
            <img
              src={heroImageSrc}
              alt={heroImageAlt}
              width="1200"
              loading="eager"
              fetchpriority="high"
              decoding="async"
            />
          </figure>
        ) : null
      }
      <h1 class="post-title">{post.title}</h1>
    </header>
    <div class="post-body">
      <BlogBody value={post.body} />
    </div>
  </article>
</Layout>

<style>
  .post {
    max-width: 40rem;
    padding-top: var(--space-16);
  }

  .post-back {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-muted);
    margin-bottom: var(--space-8);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .post-back:hover {
    color: var(--color-accent);
    text-decoration: none;
  }

  .back-arrow {
    transition: transform var(--transition);
  }

  .post-back:hover .back-arrow {
    transform: translateX(-3px);
  }

  .post-hero {
    margin: var(--space-4) 0 var(--space-8);
    padding: 0;
    max-width: 100%;
  }

  .post-hero img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: var(--radius);
  }

  .post-header {
    margin-bottom: var(--space-12);
    padding-bottom: var(--space-10);
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .post-date {
    font-size: var(--text-sm);
    color: var(--color-accent);
    font-weight: 500;
    display: block;
    margin-bottom: var(--space-4);
    font-variant-numeric: tabular-nums;
  }

  .post-title {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 4vw, var(--text-3xl));
    font-weight: 400;
    letter-spacing: -0.02em;
    margin: 0 0 var(--space-4);
    color: var(--color-fg);
    line-height: 1.25;
  }

  .post-description {
    font-size: var(--text-lg);
    color: var(--color-muted);
    margin: 0;
    line-height: 1.6;
  }

  .post-body {
    font-family: var(--font-serif);
    font-size: var(--text-base);
    line-height: 1.8;
    color: var(--color-fg-secondary);
  }

  .post-body :global(p) {
    margin: 0 0 var(--space-6);
  }

  .post-body :global(strong) {
    color: var(--color-fg);
    font-weight: 600;
  }

  .post-body :global(code) {
    font-size: 0.9em;
    padding: 0.15em 0.4em;
    background: var(--color-accent-soft);
    color: var(--color-accent);
    border-radius: var(--radius-sm);
    font-family: "SF Mono", "Fira Code", monospace;
  }

  .post-body :global(pre) {
    overflow-x: auto;
    padding: var(--space-5);
    background: var(--color-fg);
    color: var(--color-bg);
    border-radius: var(--radius);
    margin: 0 0 var(--space-6);
    border: 1px solid var(--color-border);
  }

  .post-body :global(pre code) {
    padding: 0;
    background: none;
    color: inherit;
  }

  .post-body :global(a) {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .post-body :global(blockquote) {
    margin: 0 0 var(--space-6);
    padding: var(--space-4) var(--space-6);
    border-left: 3px solid var(--color-accent);
    background: var(--color-accent-glow);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    font-style: italic;
    color: var(--color-fg-secondary);
  }

  .post-body :global(ul),
  .post-body :global(ol) {
    margin: 0 0 var(--space-6);
    padding-left: var(--space-6);
  }

  .post-body :global(li) {
    margin-bottom: var(--space-2);
  }

  .post-body :global(h1),
  .post-body :global(h2),
  .post-body :global(h3) {
    font-family: var(--font-display);
    color: var(--color-fg);
    margin-top: var(--space-10);
    margin-bottom: var(--space-4);
  }

  .post-body :global(.blog-figure) {
    margin: 0 0 var(--space-6);
  }

  .post-body :global(.blog-figure img) {
    max-width: 100%;
    height: auto;
    display: block;
    border-radius: var(--radius);
  }
</style>
