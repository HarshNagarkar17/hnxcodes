---
import Layout from "../../layouts/Layout.astro";
import { sanityClient } from "sanity:client";
import { site } from "../../data/portfolio";
import {
  POST_LIST_QUERY,
  formatPostDate,
  type PostListItem,
} from "../../lib/sanity-posts";

const posts = await sanityClient.fetch<PostListItem[]>(POST_LIST_QUERY);

function formatDate(d: Date) {
  return d.toLocaleDateString("en-GB", {
    year: "numeric",
    month: "short",
    day: "numeric",
  });
}
---

<Layout
  title={`Blog | ${site.name}`}
  description="Blog posts and writing on backend, systems, generative AI, and building things. By Harsh Nagarkar."
>
  <article class="page">
    <header class="page-header">
      <h1 class="page-title reveal reveal-delay-1">Blog</h1>
      <p class="page-desc reveal reveal-delay-2">
        Thoughts, updates, and things I'm thinking about.
      </p>
    </header>

    <ul class="blog-list">
      {
        posts.map((post) => {
          const when = formatPostDate(post.publishedAt);
          return (
            <li class="blog-row">
              {when ? <span class="blog-date">{formatDate(when)}</span> : null}
              <a href={`/blog/${post.slug}`} class="blog-link">
                {post.title}
              </a>
            </li>
          );
        })
      }
    </ul>
  </article>
</Layout>

<style>
  .page {
    padding-top: var(--space-16);
  }

  .page-header {
    margin-bottom: var(--space-12);
    max-width: 36rem;
  }

  .page-label {
    font-size: var(--text-sm);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-accent);
    margin: 0 0 var(--space-4);
  }

  .page-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, var(--text-4xl));
    font-weight: 400;
    letter-spacing: -0.03em;
    margin: 0 0 var(--space-3);
    color: var(--color-fg);
  }

  .page-desc {
    font-size: var(--text-lg);
    color: var(--color-muted);
    margin: 0;
    line-height: 1.6;
  }

  .blog-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .blog-row {
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .blog-row:last-child {
    border-bottom: none;
  }

  .blog-link {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-5) 0;
    text-decoration: none;
    color: var(--color-fg);
    position: relative;
    transition: color var(--transition-fast);
  }

  .blog-link:hover {
    color: var(--color-accent);
    text-decoration: none;
  }

  .blog-date {
    font-size: var(--text-sm);
    color: var(--color-muted);
    font-variant-numeric: tabular-nums;
    margin-bottom: var(--space-1);
  }

  .blog-link .blog-link-title {
    font-weight: 500;
    font-size: var(--text-lg);
  }

  .blog-excerpt {
    font-size: var(--text-sm);
    color: var(--color-muted);
    line-height: 1.5;
    margin-top: var(--space-1);
  }

  .blog-hover-line {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0;
    height: 2px;
    background: var(--color-accent);
    transition: width var(--transition);
  }

  .blog-link:hover .blog-hover-line {
    width: 100%;
  }
</style>
