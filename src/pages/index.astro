---
import Layout from "../layouts/Layout.astro";
import Section from "../components/Section.astro";
import { sanityClient } from "sanity:client";
import { site, skills, experience, projects } from "../data/portfolio";
import {
  POST_LIST_QUERY,
  formatPostDate,
  type PostListItem,
} from "../lib/sanity-posts";

const featuredProjects = projects.filter((p) => p.featured);
const allPosts = await sanityClient.fetch<PostListItem[]>(POST_LIST_QUERY);
const recentPosts = allPosts.slice(0, 5);
---

<Layout title={site.name} description={site.bioParagraphs[0].slice(0, 160)}>
  <article class="home">
    <header class="hero">
      <div class="hero-greeting reveal">Hello, I'm</div>
      <h1 class="hero-name reveal reveal-delay-1">{site.name}</h1>
      <p class="hero-tagline reveal reveal-delay-2">{site.tagline}</p>
      <div class="hero-bio reveal reveal-delay-3">
        {site.bioParagraphs.map((p) => <p>{p}</p>)}
      </div>
      <div class="hero-links reveal reveal-delay-4">
        {
          site.links.map((link, i) => (
            <a
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
              class="hero-link"
            >
              {link.label}
              <span class="link-arrow" aria-hidden="true">
                &rarr;
              </span>
            </a>
          ))
        }
      </div>
    </header>

    <Section id="experience" title="Experience" titleSize="small">
      <div class="experience-list">
        {
          experience.map((job) => (
            <div class="experience-card reveal">
              <div class="experience-meta">
                <span class="experience-role">{job.role}</span>
                <span class="experience-separator">&middot;</span>
                <span class="experience-company">{job.company}</span>
              </div>
              <span class="experience-period">{job.period}</span>
              <p class="experience-desc">{job.description}</p>
            </div>
          ))
        }
      </div>
    </Section>

    <Section id="skills" title="Skills" titleSize="small">
      <div class="skills-grid reveal">
        {skills.map((skill) => <span class="skill-pill">{skill}</span>)}
      </div>
    </Section>

    <Section id="work" title="Featured Work">
      <div class="projects-grid">
        {
          featuredProjects.map((project, i) => (
            <a
              href={project.href}
              target="_blank"
              rel="noopener noreferrer"
              class:list={["project-card reveal", `reveal-delay-${i + 1}`]}
            >
              <div class="project-card-header">
                <h3 class="project-name">{project.title}</h3>
                <span class="project-arrow" aria-hidden="true">
                  &nearr;
                </span>
              </div>
              <p class="project-desc">{project.description}</p>
              <div class="project-tags">
                {project.tags.map((tag) => (
                  <span class="project-tag">{tag}</span>
                ))}
              </div>
            </a>
          ))
        }
      </div>
      <p class="work-more reveal">
        <a href="/projects">View all projects &rarr;</a>
      </p>
    </Section>

    <Section id="blog" title="Recent Writing">
      <ul class="blog-list">
        {
          recentPosts.map((post) => {
            const when = formatPostDate(post.publishedAt);
            return (
              <li class="blog-row">
                {when ? (
                  <span class="blog-date">
                    {when.toLocaleDateString("en-GB", {
                      year: "numeric",
                      month: "short",
                      day: "numeric",
                    })}
                  </span>
                ) : null}
                <a href={`/blog/${post.slug}`} class="blog-title">
                  {post.title}
                </a>
              </li>
            );
          })
        }
      </ul>
      <p class="work-more reveal">
        <a href="/blog">All posts &rarr;</a>
      </p>
    </Section>
  </article>
</Layout>

<style>
  .home {
    padding-top: var(--space-16);
  }

  .hero {
    margin-bottom: var(--space-20);
    max-width: 42rem;
  }

  .hero-greeting {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-accent);
    margin: 0 0 var(--space-4);
  }

  .hero-name {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 5vw, var(--text-5xl));
    font-weight: 400;
    letter-spacing: -0.03em;
    line-height: 1.1;
    margin: 0 0 var(--space-4);
    color: var(--color-fg);
  }

  .hero-tagline {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-style: italic;
    color: var(--color-muted);
    margin: 0 0 var(--space-8);
    line-height: 1.5;
  }

  .hero-bio {
    margin: 0 0 var(--space-8);
  }

  .hero-bio p {
    margin: 0 0 var(--space-4);
    line-height: 1.75;
    color: var(--color-fg-secondary);
    font-size: var(--text-base);
  }

  .hero-bio p:last-child {
    margin-bottom: 0;
  }

  .hero-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .hero-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-muted);
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: 100px;
    text-decoration: none;
  }

  .hero-link:hover {
    text-decoration: none;
    color: var(--color-muted);
  }

  .link-arrow {
    font-size: 0.85em;
  }

  .experience-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .experience-card {
    padding: var(--space-5) var(--space-6);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }

  .experience-meta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-1);
  }

  .experience-role {
    font-weight: 600;
    color: var(--color-fg);
    font-size: var(--text-base);
  }

  .experience-separator {
    color: var(--color-border);
  }

  .experience-company {
    color: var(--color-accent);
    font-weight: 500;
  }

  .experience-period {
    font-size: var(--text-sm);
    color: var(--color-muted);
    display: block;
    margin-bottom: var(--space-3);
  }

  .experience-desc {
    margin: 0;
    color: var(--color-fg-secondary);
    line-height: 1.65;
  }

  .skills-grid {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .skill-pill {
    display: inline-flex;
    align-items: center;
    padding: var(--space-2) var(--space-4);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 100px;
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-fg-secondary);
  }

  .projects-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  .project-card {
    display: block;
    padding: var(--space-6);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    text-decoration: none;
    position: relative;
    overflow: hidden;
  }

  .project-card:hover {
    text-decoration: none;
    color: inherit;
  }

  .project-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-3);
  }

  .project-name {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 500;
    margin: 0;
    color: var(--color-fg);
  }

  .project-arrow {
    font-size: var(--text-lg);
    color: var(--color-muted);
    transition: all var(--transition);
    opacity: 0;
    transform: translate(-4px, 4px);
  }

  .project-card:hover .project-arrow {
    opacity: 1;
    transform: translate(0, 0);
    color: var(--color-accent);
  }

  .project-desc {
    margin: 0 0 var(--space-4);
    color: var(--color-fg-secondary);
    line-height: 1.65;
    font-size: var(--text-sm);
  }

  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .project-tag {
    font-size: var(--text-xs);
    font-weight: 500;
    padding: var(--space-1) var(--space-3);
    background: var(--color-accent-soft);
    color: var(--color-accent);
    border-radius: 100px;
  }

  .work-more {
    margin-top: var(--space-6);
    font-size: var(--text-sm);
    font-weight: 500;
  }

  .blog-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .blog-row {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .blog-row:last-child {
    border-bottom: none;
  }

  .blog-date {
    color: var(--color-muted);
    font-size: var(--text-sm);
    flex-shrink: 0;
    min-width: 7rem;
    font-variant-numeric: tabular-nums;
  }

  .blog-title {
    color: var(--color-fg);
    font-weight: 500;
    position: relative;
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .blog-title::after {
    content: "";
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 0;
    height: 1.5px;
    background: var(--color-accent);
    transition: width var(--transition);
  }

  .blog-title:hover {
    color: var(--color-accent);
    text-decoration: none;
  }

  .blog-title:hover::after {
    width: 100%;
  }
</style>
