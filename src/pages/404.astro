---
import Layout from "../layouts/Layout.astro";
import { site } from "../data/portfolio";
---

<Layout
  title={`404 | ${site.name}`}
  description="Page not found."
>
  <article class="not-found">
    <div class="nf-visual">
      <span class="nf-number" aria-hidden="true">404</span>
      <div class="nf-orb" aria-hidden="true">
        <div class="nf-orb-ring"></div>
        <div class="nf-orb-core"></div>
      </div>
    </div>
    <header class="nf-header">
      <h1 class="nf-title">Lost in the void</h1>
      <p class="nf-desc">This page doesn't exist, or maybe it never did.</p>
    </header>
    <a href="/" class="nf-action">
      <span class="nf-action-text">Take me home</span>
      <span class="nf-action-arrow" aria-hidden="true">&rarr;</span>
    </a>
  </article>
</Layout>

<style>
  .not-found {
    min-height: 50vh;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    padding-top: var(--space-16);
  }

  .nf-visual {
    position: relative;
    margin-bottom: var(--space-8);
  }

  .nf-number {
    font-family: var(--font-display);
    font-size: clamp(5rem, 15vw, 10rem);
    font-weight: 400;
    color: var(--color-border);
    line-height: 1;
    letter-spacing: -0.04em;
    user-select: none;
    animation: floatNumber 6s ease-in-out infinite;
  }

  @keyframes floatNumber {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-8px); }
  }

  .nf-orb {
    position: absolute;
    top: 50%;
    right: -20px;
    transform: translateY(-50%);
    width: 48px;
    height: 48px;
  }

  .nf-orb-ring {
    position: absolute;
    inset: 0;
    border: 2px solid var(--color-accent);
    border-radius: 50%;
    animation: orbSpin 8s linear infinite;
    opacity: 0.3;
  }

  .nf-orb-core {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 12px;
    height: 12px;
    background: var(--color-accent);
    border-radius: 50%;
    animation: orbPulse 2s ease-in-out infinite;
  }

  @keyframes orbSpin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  @keyframes orbPulse {
    0%, 100% { transform: translate(-50%, -50%) scale(1); opacity: 1; }
    50% { transform: translate(-50%, -50%) scale(0.6); opacity: 0.5; }
  }

  .nf-header {
    margin-bottom: var(--space-8);
  }

  .nf-title {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 400;
    margin: 0 0 var(--space-3);
    color: var(--color-fg);
    line-height: 1.3;
  }

  .nf-desc {
    font-size: var(--text-base);
    color: var(--color-muted);
    margin: 0;
    line-height: 1.6;
  }

  .nf-action {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-6);
    background: var(--color-fg);
    color: var(--color-bg);
    border-radius: 100px;
    text-decoration: none;
    font-size: var(--text-sm);
    font-weight: 500;
  }

  .nf-action:hover {
    text-decoration: none;
    color: var(--color-bg);
  }

  .nf-action-arrow {
    display: inline-block;
  }
</style>
